#!/usr/bin/env python3
"""assf — a small editor for AIM Race Studio 3 .assf analysis-profile archives.

An .assf file is a plain zip of the profile's page tree:

    0 - Time-Distance/...
    2 - Channels Report/0 - Container/0 - Channels Report/ChannelsReport.xml
    ...
    Profile.xml
    <timestamp>.txt              (version marker)

Commands:
    assf list    ARCHIVE                  show contents grouped by page
    assf cat     ARCHIVE INNERPATH        print one file (INNERPATH may be a
                                          unique substring, e.g. ChannelsReport)
    assf extract ARCHIVE [-d DIR]         unzip the whole archive
    assf edit    ARCHIVE INNERPATH        open one inner file in $EDITOR, repack
    assf put     ARCHIVE INNERPATH LOCAL  replace one inner file with LOCAL
    assf report-channels ARCHIVE          show the Channels Report channel list
    assf add-report-channel ARCHIVE NAME --oper N
                                          append a MainChan to the Channels Report
    assf remove-report-channel ARCHIVE NAME [--oper N]
                                          remove Channels Report entries

Every modifying command first copies the archive to ARCHIVE.bak-YYYYmmdd_HHMMSS
(disable with --no-backup) and then replaces it atomically. Close Race Studio 3
before editing archives it may be using.
"""

import argparse
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import zipfile
import xml.etree.ElementTree as ET


def die(msg):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def open_zip(path):
    if not os.path.isfile(path):
        die(f"no such file: {path}")
    try:
        return zipfile.ZipFile(path, "r")
    except zipfile.BadZipFile:
        die(f"{path} is not a valid zip/.assf archive")


def resolve_inner(zf, needle):
    """Resolve an inner path; allow a unique substring match (case-insensitive)."""
    names = zf.namelist()
    if needle in names:
        return needle
    hits = [n for n in names if needle.lower() in n.lower()]
    if len(hits) == 1:
        return hits[0]
    if not hits:
        die(f"no entry matching '{needle}' in archive")
    die("ambiguous name '%s', matches:\n  %s" % (needle, "\n  ".join(hits)))


def warn_if_rs3_running():
    tasklist = "/mnt/c/Windows/System32/tasklist.exe"
    if not os.path.exists(tasklist):
        return
    try:
        out = subprocess.run([tasklist], capture_output=True, text=True,
                             timeout=10).stdout
    except Exception:
        return
    if "AiMRS3" in out:
        print("WARNING: Race Studio 3 appears to be running. It may overwrite "
              "or ignore your edit — close it first.", file=sys.stderr)


def rewrite(archive, replacements, backup=True):
    """Rewrite the archive with {inner_name: bytes} replaced, preserving
    entry order, compression, and the timestamps of untouched entries."""
    warn_if_rs3_running()
    with zipfile.ZipFile(archive, "r") as zf:
        infos = zf.infolist()
        data = {i.filename: zf.read(i) for i in infos}
    unknown = set(replacements) - set(data)
    if unknown:
        die(f"entries not present in archive: {sorted(unknown)}")

    if backup:
        bak = f"{archive}.bak-{time.strftime('%Y%m%d_%H%M%S')}"
        shutil.copy2(archive, bak)
        print(f"backup: {bak}")

    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(os.path.abspath(archive)),
                               suffix=".assf.tmp")
    os.close(fd)
    try:
        with zipfile.ZipFile(tmp, "w", zipfile.ZIP_DEFLATED) as out:
            for info in infos:
                new = zipfile.ZipInfo(info.filename)
                new.compress_type = zipfile.ZIP_DEFLATED
                new.external_attr = info.external_attr
                if info.filename in replacements:
                    new.date_time = time.localtime()[:6]
                    out.writestr(new, replacements[info.filename])
                else:
                    new.date_time = info.date_time
                    out.writestr(new, data[info.filename])
        os.replace(tmp, archive)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise
    print(f"wrote {archive}")


def cmd_list(args):
    with open_zip(args.archive) as zf:
        infos = zf.infolist()
    page = None
    for info in infos:
        top = info.filename.split("/")[0] if "/" in info.filename else "(root)"
        if top != page:
            page = top
            print(f"\n{page}/" if page != "(root)" else "\n(top level)")
        d = "%04d-%02d-%02d" % info.date_time[:3]
        print(f"  {info.file_size:>8}  {d}  {info.filename.split('/', 1)[-1] if '/' in info.filename else info.filename}")
    print(f"\n{len(infos)} files")


def cmd_cat(args):
    with open_zip(args.archive) as zf:
        name = resolve_inner(zf, args.inner)
        sys.stdout.write(zf.read(name).decode("utf-8", errors="replace"))


def cmd_extract(args):
    dest = args.dir or os.path.splitext(os.path.basename(args.archive))[0]
    with open_zip(args.archive) as zf:
        zf.extractall(dest)
        n = len(zf.namelist())
    print(f"extracted {n} files to {dest}/")


def cmd_edit(args):
    with open_zip(args.archive) as zf:
        name = resolve_inner(zf, args.inner)
        original = zf.read(name)
    editor = os.environ.get("EDITOR") or shutil.which("nano") or shutil.which("vi")
    if not editor:
        die("no editor found; set $EDITOR")
    suffix = "." + name.rsplit(".", 1)[-1] if "." in name else ".txt"
    fd, tmp = tempfile.mkstemp(suffix=suffix)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(original)
        subprocess.run([editor, tmp], check=True)
        with open(tmp, "rb") as f:
            edited = f.read()
    finally:
        os.unlink(tmp)
    if edited == original:
        print("no changes made; archive untouched")
        return
    if name.endswith(".xml"):
        try:
            ET.fromstring(edited)
        except ET.ParseError as e:
            die(f"edited file is not well-formed XML ({e}); archive untouched")
    rewrite(args.archive, {name: edited}, backup=not args.no_backup)
    print(f"updated {name}")


def cmd_put(args):
    if not os.path.isfile(args.local):
        die(f"no such file: {args.local}")
    with open_zip(args.archive) as zf:
        name = resolve_inner(zf, args.inner)
    with open(args.local, "rb") as f:
        content = f.read()
    if name.endswith(".xml"):
        try:
            ET.fromstring(content)
        except ET.ParseError as e:
            die(f"{args.local} is not well-formed XML ({e}); archive untouched")
    rewrite(args.archive, {name: content}, backup=not args.no_backup)
    print(f"replaced {name} with contents of {args.local}")


def find_channels_report(zf):
    hits = [n for n in zf.namelist() if n.endswith("ChannelsReport.xml")
            and "Graph" not in n]
    if not hits:
        die("no ChannelsReport.xml found in this archive")
    if len(hits) > 1:
        die("multiple ChannelsReport.xml entries; use 'edit' directly:\n  "
            + "\n  ".join(hits))
    return hits[0]


def cmd_report_channels(args):
    with open_zip(args.archive) as zf:
        name = find_channels_report(zf)
        root = ET.fromstring(zf.read(name))
    print(f"# {name}")
    for ch in root.findall("MainChan"):
        print(f"  {ch.findtext('Name'):<24} Oper={ch.findtext('Oper')}")


def cmd_add_report_channel(args):
    with open_zip(args.archive) as zf:
        name = find_channels_report(zf)
        raw = zf.read(name).decode("utf-8")
    if f"<Name>{args.name}</Name>" in raw:
        existing = [ln for ln in raw.splitlines() if args.name in ln]
        print(f"note: '{args.name}' already appears in the report "
              f"({len(existing)} entries); adding another with Oper={args.oper}")
    # Splice in a MainChan block before </Panel>, matching the file's style.
    block = (f"  <MainChan>\n    <Name>{args.name}</Name>\n"
             f"    <Oper>{args.oper}</Oper>\n  </MainChan>\n")
    if "</Panel>" not in raw:
        die(f"unexpected format in {name}: no </Panel> closing tag")
    updated = raw.replace("</Panel>", block + "</Panel>")
    ET.fromstring(updated)  # sanity check
    rewrite(args.archive, {name: updated.encode("utf-8")},
            backup=not args.no_backup)
    print(f"added <MainChan> {args.name} (Oper={args.oper}) to {name}")


def cmd_remove_report_channel(args):
    with open_zip(args.archive) as zf:
        name = find_channels_report(zf)
        raw = zf.read(name).decode("utf-8")
    oper = str(args.oper) if args.oper is not None else "[^<]*"
    pattern = re.compile(
        r"[ \t]*<MainChan>\s*<Name>%s</Name>\s*<Oper>%s</Oper>\s*</MainChan>[ \t]*\n?"
        % (re.escape(args.name), oper))
    updated, count = pattern.subn("", raw)
    if count == 0:
        die(f"no MainChan entry matching Name='{args.name}'"
            + (f" Oper={args.oper}" if args.oper is not None else "")
            + f" in {name}")
    ET.fromstring(updated)  # sanity check
    rewrite(args.archive, {name: updated.encode("utf-8")},
            backup=not args.no_backup)
    print(f"removed {count} MainChan entr{'y' if count == 1 else 'ies'} "
          f"for '{args.name}' from {name}")


def main():
    p = argparse.ArgumentParser(
        prog="assf", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    def add(name, fn, *specs, modifies=False):
        sp = sub.add_parser(name)
        sp.add_argument("archive", help=".assf file")
        for s in specs:
            sp.add_argument(*s[0], **s[1])
        if modifies:
            sp.add_argument("--no-backup", action="store_true",
                            help="skip the automatic .bak copy")
        sp.set_defaults(fn=fn)
        return sp

    add("list", cmd_list)
    add("cat", cmd_cat, (["inner"], {"help": "inner path or unique substring"}))
    add("extract", cmd_extract, (["-d", "--dir"], {"help": "destination dir"}))
    add("edit", cmd_edit,
        (["inner"], {"help": "inner path or unique substring"}), modifies=True)
    add("put", cmd_put,
        (["inner"], {"help": "inner path or unique substring"}),
        (["local"], {"help": "local file whose contents replace the entry"}),
        modifies=True)
    add("report-channels", cmd_report_channels)
    add("add-report-channel", cmd_add_report_channel,
        (["name"], {"help": "channel name exactly as RS3 shows it"}),
        (["--oper"], {"required": True, "type": int,
                      "help": "operation code; copy the value from an existing "
                              "entry doing the same stat (see report-channels)"}),
        modifies=True)
    add("remove-report-channel", cmd_remove_report_channel,
        (["name"], {"help": "channel name exactly as shown by report-channels"}),
        (["--oper"], {"type": int,
                      "help": "only remove the entry with this operation code; "
                              "omit to remove all entries for the channel"}),
        modifies=True)

    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
