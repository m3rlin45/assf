#!/usr/bin/env python3
"""assf — a small editor for AIM Race Studio 3 .assf analysis-profile archives.

An .assf file is a plain zip of the profile's page tree:

    0 - Time-Distance/...
    2 - Channels Report/0 - Container/0 - Channels Report/ChannelsReport.xml
    ...
    Profile.xml
    <timestamp>.txt              (version marker)

Commands:
    assf list    ARCHIVE                  show contents grouped by page
    assf cat     ARCHIVE INNERPATH        print one file (INNERPATH may be a
                                          unique substring, e.g. ChannelsReport)
    assf extract ARCHIVE [-d DIR]         unzip the whole archive
    assf edit    ARCHIVE INNERPATH        open one inner file in $EDITOR, repack
    assf put     ARCHIVE INNERPATH LOCAL  replace one inner file with LOCAL
    assf report-channels ARCHIVE          show the Channels Report channel list
    assf add-report-channel ARCHIVE NAME --oper N
                                          append a MainChan to the Channels Report
    assf remove-report-channel ARCHIVE NAME [--oper N]
                                          remove Channels Report entries
    assf check   ARCHIVE                  report stale page dirs / index
                                          collisions vs Profile.xml Layouts
    assf clean   ARCHIVE [--dry-run]      remove page dirs not registered in
                                          Profile.xml (fixes silent page drops)
    assf latest  [DIR]                    print the newest version of each
                                          profile — the file RS3 actually loads

RS3 behavior notes (learned the hard way; see README for the full story):
  - RS3 loads the highest-timestamp <profile>.<ts>.assf and silently writes
    NEW versions during profile loads, so "the newest file" moves around.
    Always run `assf latest` before editing; modifying commands warn if a
    newer version of the same profile exists.
  - Plotted-channel visibility lives in each page's top-level Layout-*.xml
    (`<PlotVisible>true`), not in the nested panel XMLs.
  - Channels Report edits are picked up by a running RS3; layout/visibility
    edits require a full app restart to take effect.

Every modifying command first copies the archive to ARCHIVE.bak-YYYYmmdd_HHMMSS
(disable with --no-backup) and then replaces it atomically. Close Race Studio 3
before editing archives it may be using.
"""

import argparse
import glob
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import zipfile
import xml.etree.ElementTree as ET


def die(msg):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def open_zip(path):
    if not os.path.isfile(path):
        die(f"no such file: {path}")
    try:
        return zipfile.ZipFile(path, "r")
    except zipfile.BadZipFile:
        die(f"{path} is not a valid zip/.assf archive")


def resolve_inner(zf, needle):
    """Resolve an inner path; allow a unique substring match (case-insensitive)."""
    names = zf.namelist()
    if needle in names:
        return needle
    hits = [n for n in names if needle.lower() in n.lower()]
    if len(hits) == 1:
        return hits[0]
    if not hits:
        die(f"no entry matching '{needle}' in archive")
    die("ambiguous name '%s', matches:\n  %s" % (needle, "\n  ".join(hits)))


def warn_if_rs3_running():
    tasklist = "/mnt/c/Windows/System32/tasklist.exe"
    if not os.path.exists(tasklist):
        return
    try:
        out = subprocess.run([tasklist], capture_output=True, text=True,
                             timeout=10).stdout
    except Exception:
        return
    if "AiMRS3" in out:
        print("WARNING: Race Studio 3 appears to be running. It may overwrite "
              "or ignore your edit — close it first.", file=sys.stderr)


VERSION_RE = r"(.*)\.(\d{8}_\d{6})\.assf$"


def newest_version(archive):
    """Return (newest_path, is_stale) for the profile this archive belongs to.

    RS3 loads the highest-timestamp <profile>.<ts>.assf in the folder, and it
    silently writes NEW versions during profile loads (not only on explicit
    saves) — so the newest file moves around. Editing anything but the newest
    version has no effect on what RS3 shows.
    """
    m = re.match(VERSION_RE, os.path.basename(archive))
    if not m:
        return None, False
    d = os.path.dirname(os.path.abspath(archive))
    best, best_ts = os.path.abspath(archive), m.group(2)
    for p in glob.glob(os.path.join(d, glob.escape(m.group(1)) + ".*.assf")):
        mm = re.match(VERSION_RE, os.path.basename(p))
        if mm and mm.group(2) > best_ts:
            best, best_ts = p, mm.group(2)
    return best, os.path.abspath(archive) != best


def warn_if_stale_version(archive):
    newest, stale = newest_version(archive)
    if stale:
        print(f"WARNING: this is NOT the newest version of the profile — "
              f"RS3 loads {os.path.basename(newest)}. Your edit will have no "
              f"visible effect unless you edit that file instead.",
              file=sys.stderr)


def make_backup(archive):
    """Back up into an assf-backups/ subfolder — never alongside the archives,
    so RS3's profile scanning (and humans) can't confuse backups with live
    versions."""
    bdir = os.path.join(os.path.dirname(os.path.abspath(archive)),
                        "assf-backups")
    os.makedirs(bdir, exist_ok=True)
    bak = os.path.join(bdir, os.path.basename(archive)
                       + ".bak-" + time.strftime("%Y%m%d_%H%M%S"))
    shutil.copy2(archive, bak)
    print(f"backup: {bak}")


def rewrite(archive, replacements, backup=True):
    """Rewrite the archive with {inner_name: bytes} replaced, preserving
    entry order, compression, and the timestamps of untouched entries."""
    warn_if_rs3_running()
    warn_if_stale_version(archive)
    with zipfile.ZipFile(archive, "r") as zf:
        infos = zf.infolist()
        data = {i.filename: zf.read(i) for i in infos}
    unknown = set(replacements) - set(data)
    if unknown:
        die(f"entries not present in archive: {sorted(unknown)}")

    if backup:
        make_backup(archive)

    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(os.path.abspath(archive)),
                               suffix=".assf.tmp")
    os.close(fd)
    try:
        with zipfile.ZipFile(tmp, "w", zipfile.ZIP_DEFLATED) as out:
            for info in infos:
                new = zipfile.ZipInfo(info.filename)
                new.compress_type = zipfile.ZIP_DEFLATED
                new.external_attr = info.external_attr
                if info.filename in replacements:
                    new.date_time = time.localtime()[:6]
                    out.writestr(new, replacements[info.filename])
                else:
                    new.date_time = info.date_time
                    out.writestr(new, data[info.filename])
        os.replace(tmp, archive)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise
    print(f"wrote {archive}")


def cmd_list(args):
    with open_zip(args.archive) as zf:
        infos = zf.infolist()
    page = None
    for info in infos:
        top = info.filename.split("/")[0] if "/" in info.filename else "(root)"
        if top != page:
            page = top
            print(f"\n{page}/" if page != "(root)" else "\n(top level)")
        d = "%04d-%02d-%02d" % info.date_time[:3]
        print(f"  {info.file_size:>8}  {d}  {info.filename.split('/', 1)[-1] if '/' in info.filename else info.filename}")
    print(f"\n{len(infos)} files")


def cmd_cat(args):
    with open_zip(args.archive) as zf:
        name = resolve_inner(zf, args.inner)
        sys.stdout.write(zf.read(name).decode("utf-8", errors="replace"))


def cmd_extract(args):
    dest = args.dir or os.path.splitext(os.path.basename(args.archive))[0]
    with open_zip(args.archive) as zf:
        zf.extractall(dest)
        n = len(zf.namelist())
    print(f"extracted {n} files to {dest}/")


def cmd_edit(args):
    with open_zip(args.archive) as zf:
        name = resolve_inner(zf, args.inner)
        original = zf.read(name)
    editor = os.environ.get("EDITOR") or shutil.which("nano") or shutil.which("vi")
    if not editor:
        die("no editor found; set $EDITOR")
    suffix = "." + name.rsplit(".", 1)[-1] if "." in name else ".txt"
    fd, tmp = tempfile.mkstemp(suffix=suffix)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(original)
        subprocess.run([editor, tmp], check=True)
        with open(tmp, "rb") as f:
            edited = f.read()
    finally:
        os.unlink(tmp)
    if edited == original:
        print("no changes made; archive untouched")
        return
    if name.endswith(".xml"):
        try:
            ET.fromstring(edited)
        except ET.ParseError as e:
            die(f"edited file is not well-formed XML ({e}); archive untouched")
    rewrite(args.archive, {name: edited}, backup=not args.no_backup)
    print(f"updated {name}")


def cmd_put(args):
    if not os.path.isfile(args.local):
        die(f"no such file: {args.local}")
    with open_zip(args.archive) as zf:
        name = resolve_inner(zf, args.inner)
    with open(args.local, "rb") as f:
        content = f.read()
    if name.endswith(".xml"):
        try:
            ET.fromstring(content)
        except ET.ParseError as e:
            die(f"{args.local} is not well-formed XML ({e}); archive untouched")
    rewrite(args.archive, {name: content}, backup=not args.no_backup)
    print(f"replaced {name} with contents of {args.local}")


def find_channels_report(zf):
    hits = [n for n in zf.namelist() if n.endswith("ChannelsReport.xml")
            and "Graph" not in n]
    if not hits:
        die("no ChannelsReport.xml found in this archive")
    if len(hits) > 1:
        die("multiple ChannelsReport.xml entries; use 'edit' directly:\n  "
            + "\n  ".join(hits))
    return hits[0]


def cmd_report_channels(args):
    with open_zip(args.archive) as zf:
        name = find_channels_report(zf)
        root = ET.fromstring(zf.read(name))
    print(f"# {name}")
    for ch in root.findall("MainChan"):
        print(f"  {ch.findtext('Name'):<24} Oper={ch.findtext('Oper')}")


def cmd_add_report_channel(args):
    with open_zip(args.archive) as zf:
        name = find_channels_report(zf)
        raw = zf.read(name).decode("utf-8")
    if f"<Name>{args.name}</Name>" in raw:
        existing = [ln for ln in raw.splitlines() if args.name in ln]
        print(f"note: '{args.name}' already appears in the report "
              f"({len(existing)} entries); adding another with Oper={args.oper}")
    # Splice in a MainChan block before </Panel>, matching the file's style.
    block = (f"  <MainChan>\n    <Name>{args.name}</Name>\n"
             f"    <Oper>{args.oper}</Oper>\n  </MainChan>\n")
    if "</Panel>" not in raw:
        die(f"unexpected format in {name}: no </Panel> closing tag")
    updated = raw.replace("</Panel>", block + "</Panel>")
    ET.fromstring(updated)  # sanity check
    rewrite(args.archive, {name: updated.encode("utf-8")},
            backup=not args.no_backup)
    print(f"added <MainChan> {args.name} (Oper={args.oper}) to {name}")


def get_layouts(prof_xml):
    """Return {idx: page_name} registered in Profile.xml's <Layouts> list."""
    return {int(m.group(1)): m.group(2) for m in re.finditer(
        r'<Layout Idx="(\d+)" Type="\d+">([^<]*)</Layout>', prof_xml)}


def cmd_latest(args):
    d = args.dir or "."
    newest = {}
    for p in glob.glob(os.path.join(d, "*.assf")):
        m = re.match(VERSION_RE, os.path.basename(p))
        if m and (m.group(1) not in newest or m.group(2) > newest[m.group(1)][0]):
            newest[m.group(1)] = (m.group(2), p)
    if not newest:
        die(f"no versioned .assf files in {d}")
    for name in sorted(newest, key=str.lower):
        print(newest[name][1])


def cmd_check(args):
    with open_zip(args.archive) as zf:
        names = zf.namelist()
        try:
            prof = zf.read("Profile.xml").decode("utf-8", "replace")
        except KeyError:
            die("archive has no Profile.xml")
    layouts = get_layouts(prof)
    tops = sorted({n.split("/")[0] for n in names if "/" in n})
    issues = 0
    for top in tops:
        m = re.match(r"(\d+) - (.*)$", top)
        if not m:
            continue
        idx, page = int(m.group(1)), m.group(2)
        if layouts.get(idx) != page:
            kind = ("COLLISION with active '%s'" % layouts[idx]
                    if idx in layouts else "unregistered leftover")
            print(f"  stale: {top}/  ({kind})")
            issues += 1
    for idx, page in sorted(layouts.items()):
        if f"{idx} - {page}" not in tops:
            print(f"  MISSING: registered page {idx}:{page} has no directory")
            issues += 1
    print(f"{len(layouts)} registered pages, {len(tops)} page dirs, "
          f"{issues} issue(s)")
    sys.exit(1 if issues else 0)


def cmd_clean(args):
    with open_zip(args.archive) as zf:
        names = zf.namelist()
        try:
            prof = zf.read("Profile.xml").decode("utf-8", "replace")
        except KeyError:
            die("archive has no Profile.xml")
    layouts = get_layouts(prof)
    if not layouts:
        die("no <Layout> entries found in Profile.xml; refusing to clean")
    keep_tops = {f"{i} - {p}" for i, p in layouts.items()}
    drop = []
    for n in names:
        top = n.split("/")[0] if "/" in n else None
        if top and re.match(r"\d+ - ", top) and top not in keep_tops:
            drop.append(n)
    if not drop:
        print("archive is already clean; nothing to remove")
        return
    for top in sorted({n.split("/")[0] for n in drop}):
        print(f"  removing {top}/")
    if args.dry_run:
        print(f"dry run: would remove {len(drop)} files")
        return
    # rewrite() replaces content; removal needs its own pass
    warn_if_rs3_running()
    warn_if_stale_version(args.archive)
    with zipfile.ZipFile(args.archive, "r") as zf:
        infos = [i for i in zf.infolist() if i.filename not in set(drop)]
        data = {i.filename: zf.read(i) for i in infos}
    if not args.no_backup:
        make_backup(args.archive)
    fd, tmp = tempfile.mkstemp(
        dir=os.path.dirname(os.path.abspath(args.archive)), suffix=".assf.tmp")
    os.close(fd)
    try:
        with zipfile.ZipFile(tmp, "w", zipfile.ZIP_DEFLATED) as out:
            for info in infos:
                new = zipfile.ZipInfo(info.filename)
                new.compress_type = zipfile.ZIP_DEFLATED
                new.external_attr = info.external_attr
                new.date_time = info.date_time
                out.writestr(new, data[info.filename])
        os.replace(tmp, args.archive)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise
    print(f"removed {len(drop)} files; wrote {args.archive}")


def cmd_remove_report_channel(args):
    with open_zip(args.archive) as zf:
        name = find_channels_report(zf)
        raw = zf.read(name).decode("utf-8")
    oper = str(args.oper) if args.oper is not None else "[^<]*"
    pattern = re.compile(
        r"[ \t]*<MainChan>\s*<Name>%s</Name>\s*<Oper>%s</Oper>\s*</MainChan>[ \t]*\n?"
        % (re.escape(args.name), oper))
    updated, count = pattern.subn("", raw)
    if count == 0:
        die(f"no MainChan entry matching Name='{args.name}'"
            + (f" Oper={args.oper}" if args.oper is not None else "")
            + f" in {name}")
    ET.fromstring(updated)  # sanity check
    rewrite(args.archive, {name: updated.encode("utf-8")},
            backup=not args.no_backup)
    print(f"removed {count} MainChan entr{'y' if count == 1 else 'ies'} "
          f"for '{args.name}' from {name}")


def main():
    p = argparse.ArgumentParser(
        prog="assf", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    def add(name, fn, *specs, modifies=False):
        sp = sub.add_parser(name)
        sp.add_argument("archive", help=".assf file")
        for s in specs:
            sp.add_argument(*s[0], **s[1])
        if modifies:
            sp.add_argument("--no-backup", action="store_true",
                            help="skip the automatic .bak copy")
        sp.set_defaults(fn=fn)
        return sp

    add("list", cmd_list)
    add("cat", cmd_cat, (["inner"], {"help": "inner path or unique substring"}))
    add("extract", cmd_extract, (["-d", "--dir"], {"help": "destination dir"}))
    add("edit", cmd_edit,
        (["inner"], {"help": "inner path or unique substring"}), modifies=True)
    add("put", cmd_put,
        (["inner"], {"help": "inner path or unique substring"}),
        (["local"], {"help": "local file whose contents replace the entry"}),
        modifies=True)
    add("report-channels", cmd_report_channels)
    add("add-report-channel", cmd_add_report_channel,
        (["name"], {"help": "channel name exactly as RS3 shows it"}),
        (["--oper"], {"required": True, "type": int,
                      "help": "operation code; copy the value from an existing "
                              "entry doing the same stat (see report-channels)"}),
        modifies=True)
    sp_latest = sub.add_parser("latest")
    sp_latest.add_argument("dir", nargs="?",
                           help="profiles-available directory (default: .)")
    sp_latest.set_defaults(fn=cmd_latest)
    add("check", cmd_check)
    sp_clean = add("clean", cmd_clean, modifies=True)
    sp_clean.add_argument("--dry-run", action="store_true",
                          help="show what would be removed without writing")
    add("remove-report-channel", cmd_remove_report_channel,
        (["name"], {"help": "channel name exactly as shown by report-channels"}),
        (["--oper"], {"type": int,
                      "help": "only remove the entry with this operation code; "
                              "omit to remove all entries for the channel"}),
        modifies=True)

    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
